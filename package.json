{
  "name": "quiet-clojure-syntax",
  "displayName": "Quiet Clojure Syntax",
  "description": "Additional TextMate scopes for restrained, customizable Clojure syntax highlighting in Calva.",
  "version": "0.0.1",
  "publisher": "vlaaad",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vlaaad/vscode-quiet-clojure.git"
  },
  "scripts": {
    "test": "node test/grammar.mjs"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "clojure",
    "calva",
    "syntax highlighting",
    "textmate"
  ],
  "extensionDependencies": [
    "betterthantomorrow.calva"
  ],
  "extensionKind": [
    "ui"
  ],
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.2.0"
  },
  "contributes": {
    "grammars": [
      {
        "scopeName": "quiet-clojure.injection",
        "path": "./syntaxes/quiet-clojure.tmLanguage.json",
        "injectTo": [
          "source.clojure"
        ]
      }
    ]
  }
}
